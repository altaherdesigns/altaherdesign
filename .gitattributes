# Normalise line endings so Windows, macOS and Linux all agree.
# Text files are stored as LF in the repo; Git handles the working copy.
* text=auto eol=lf

# Web source — always LF, including in the working directory.
*.html   text eol=lf
*.css    text eol=lf
*.js     text eol=lf
*.json   text eol=lf
*.xml    text eol=lf
*.txt    text eol=lf
*.md     text eol=lf
*.svg    text eol=lf
*.webmanifest text eol=lf

# Cloudflare Pages config files — LF matters, these are parsed at build time.
_headers    text eol=lf
_redirects  text eol=lf

# Binary — never touch these.
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.webp   binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.eot    binary
*.pdf    binary
*.zip    binary

# Cloudflare Pages headers: performance and security
#
# How Pages combines rules: a request inherits the headers of EVERY rule whose
# pattern matches it, and when two matching rules set the same header the
# values are joined with a comma. So Cache-Control must never be set in /*
# as well as in /assets/*: assets would get "max-age=0, must-revalidate, ...,
# max-age=31536000, immutable" and browsers read the first max-age (0), which
# made every page view re-check every CSS, JS, font and image file.
#
# HTML pages get the Pages default (public, max-age=0, must-revalidate).

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000

# Static assets: cached for a year. CSS and JS are referenced as ?v=YYYYMMDDNN,
# so bump that number on every CSS or JS change. Fonts and images change name
# when they change.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Feeds and maps: short cache, they change with content
/sitemap.xml
  Cache-Control: public, max-age=3600
/robots.txt
  Cache-Control: public, max-age=3600
/llms.txt
  Cache-Control: public, max-age=3600

# Working docs live in the repo but shouldn't be indexed or cached
/*.md
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

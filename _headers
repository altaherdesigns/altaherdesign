# Cloudflare Pages headers — performance & security

# Default: HTML pages. Clean URLs (/services/metal-gates/) are served as HTML,
# so this must be /* rather than /*.html — the old rule never matched a real
# page request. stale-while-revalidate serves instantly from cache while
# refreshing in the background.
/*
  Cache-Control: public, max-age=0, must-revalidate, stale-while-revalidate=86400
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Fingerprint-free static assets — safe to cache hard, they change by filename
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/assets/css/*
  Cache-Control: public, max-age=31536000, immutable

/assets/js/*
  Cache-Control: public, max-age=31536000, immutable

/assets/images/*
  Cache-Control: public, max-age=31536000, immutable

# Feeds and maps — short cache, they change with content
/sitemap.xml
  Cache-Control: public, max-age=3600
/robots.txt
  Cache-Control: public, max-age=3600
/llms.txt
  Cache-Control: public, max-age=3600

# Working docs live in the repo but shouldn't be indexed or cached
/*.md
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
